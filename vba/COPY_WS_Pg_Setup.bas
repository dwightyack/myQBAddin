' Function: AppendRtoWB
' r is the range to be APPENDED to the workbook.
' pANDf = FULL Path AND Filename of workbook.
' Workbook is created if it does Not exist.
' Optional replaceflag = True replace everything in file if exists, otherwise Ask the user.
' Optional closeWB = True close file, otherwise leave it Open.
' Optional verbose = True prompt user before appending or deleting any existing file
' Return the FINAL name of the new wB
Function AppendRtoWB(r As Range, pANDf As String, Optional replaceflag As Boolean = True, _
            Optional closeWB As Boolean = False, Optional verbose As Boolean = False) As String '
Dim m As String, ans As Long, E As String
Dim new_wb As Workbook, rB As Range, last_r As Long
Dim createWb As Boolean
    On Error Resume Next
    
    If r Is Nothing Then GoTo Error_Abort
    
    If FileOrFolderExists(pANDf) Then
        If replaceflag Then
            If verbose Then
                m = "'" & pANDf & "'" & vbCrLf & vbCrLf _
                        & "Warning: This Folder or File Exists.  DELETE  this file and continue?" _
                        & vbCrLf & "Press No or Cancel to Abort."
                ans = MsgBox(m, vbYesNoCancel, "WARNING!")
                If ans <> vbYes Then E = E & "User canceled Delete.": GoTo Error_Abort
            End If ' verbose
            ' Deleting the File first
            myDeleteExistFile pANDf
            createWb = True
        Else ' Not replacing file
            If verbose Then
                m = "'" & pANDf & "'" & vbCrLf & vbCrLf _
                        & "Warning: APPENDING this file." _
                        & vbCrLf & "Press No or Cancel to Abort."
                ans = MsgBox(m, vbYesNoCancel, "WARNING!")
                If ans <> vbYes Then E = E & "User canceled Append.": GoTo Error_Abort
            End If ' verbose
        End If
    Else
        createWb = True
    End If
    
    Application.DisplayAlerts = False ' Turn Off Prompts for Save, etc ' Comment out for testing
      
    ' Open a new workbook
    If createWb Then
        Set new_wb = Workbooks.Add
        With new_wb
            .SaveAs fileName:=pANDf
        End With
    Else
        Workbooks.Open fileName:=pANDf
        Set new_wb = ActiveWorkbook
        If new_wb.fullName <> pANDf Then E = "Could NOT open '" & pANDf & "'": GoTo Error_Abort
    End If
    If new_wb Is Nothing Then
        E = E & "Could NOT open " & pANDf & "."
         GoTo Error_Abort
    End If
    
    ' New workbook is now Active
    ' Set the target range size to EXACT SAME SIZE as r
    If replaceflag Then ' start from row 1
         Set rB = Range(Cells(1, 1), Cells(1 + r.Rows.count - 1, 1 + r.Columns.count - 1))
    Else
        last_r = Last(1, Cells)
         Set rB = Range(Cells(last_r + 1, 1), Cells(last_r + 1 + r.Rows.count - 1, 1 + r.Columns.count - 1))
    End If
    
    ' Ranges must be exactly the same size.
    rB.Value = r.Value '  ONLY copies Values. Formatting is not changed.
    
    ' Save the workbook
    new_wb.Save
    'MsgBox new_wb.FullName
    ' Close the Workbook option passed in?
    If closeWB Then new_wb.Close SaveChanges:=True '  Close opened WB
    
    ' Activate the original worksheet the range is from
    Worksheets(r.Worksheet.name).Activate
    r.Cells(1, 1).Select
    
    Application.DisplayAlerts = True ' Turn back On Application Prompts
    AppendRtoWB = pANDf ' return the path and filename.
    Exit Function
Error_Abort:
    Application.DisplayAlerts = True ' Turn back On Application Prompts
    E = "AppendRtoWB: " & E & vbCrLf & "Aborting..."
    Debug.Print E
End Function
