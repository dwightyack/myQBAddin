'
' My Favorite WorkBook Open DIALOG function
' Opens a Workbook
'   optional WB is set to something OTHER THAN Addin workbook
' WARNING: When passing in FILTER use META characters. ex. "*.csv" instead of ".csv"
''''''''''' '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
Public Function myOpenWorkbook(Optional Read_Only_Op As Boolean = False, Optional FILTER As String = "*.xls*", _
    Optional wb As Workbook, Optional Initial_Fn As String = "") As Workbook
    ' tested from my Test File Open Box.xlsm test file and the following link
Dim fd As FileDialog
Dim fileName As String, m As String, ans As Long
Dim fileChosen As Integer 'the number of the button chosen
    If wb Is Nothing Then
        Set OPEN_WB = ActiveWorkbook ' saved for use by User Form code later
        'MsgBox "Setting OPEN_WB to workbook '" & ActiveWorkbook.name & "'"
    Else
        Set OPEN_WB = wb ' saved for use by User Form code later for importing sheet to workbook
        'MsgBox "Setting OPEN_WB to workbook '" & WB.name & "'"
    End If
    Set fd = Application.FileDialog(msoFileDialogOpen)
    fd.Title = "Choose workbook"
    If Initial_Fn = "" Then _
        Initial_Fn = "\\NAS\BBMDATA\Dwight\QUICKBOOKS WORK AREA\"  ' make sure to add the last "\"
    If Not newFileOrFolderExists(Initial_Fn) Then
        m = "'" & Initial_Fn & "'" & vbCrLf & vbCrLf & "Warning: This Folder or File Does NOT Exist." & _
            "Opening default Documents folder.'"
        ans = MsgBox(m, vbInformation, "INVALID FILE OR DIRECTORY!")
        Initial_Fn = ""
    End If
        ' Normalize the path to replace '/' with backslashes for consistency
    fd.InitialFileName = Replace(Initial_Fn, "/", "\")
        ' Add last '\' to end if its a folder
    If FolderExists(fd.InitialFileName) And Right(fd.InitialFileName, 1) <> "\" Then
        fd.InitialFileName = fd.InitialFileName & "\"
    End If
    fd.InitialView = msoFileDialogViewList
    fd.ButtonName = "Choose this file"
    fd.AllowMultiSelect = False
    fd.Filters.Clear
    fd.Filters.Add "ALL Files...", "*.*" ' Add this for second drop down choice
    If FILTER = "*.xls*" Then
        fd.Filters.Add "ALL Excel Files", "*.xls*"
    Else
        fd.Filters.Add "All Files with... ", FILTER
    End If
    fd.FilterIndex = 2
   ' Show File Dialog Window
    fileChosen = fd.Show
    If fileChosen <> -1 Then
        'didn't choose anything (clicked on CANCEL)
        ' MsgBox "No file opened!..."
    Else
        ' Open filename (NAME property
        ' includes path, which we need. Optional Read_Only_Op passed in
        fileName = fd.SelectedItems(1)
        If FilenameFromPath(fileName) = ActiveWorkbook.name Then
            Err.Clear
            m = "Sorry... Can't open a file with the same file name as Active workbook!"
            m = m & vbCrLf & vbCrLf & "ABORTING..."
            ans = MsgBox(m, vbCritical, "   CAN'T OPEN... " & FilenameFromPath(fileName))
            GoTo AbortOpen
        End If
        Workbooks.Open fileName:=fileName, ReadOnly:=Read_Only_Op
        Set myOpenWorkbook = ActiveWorkbook
    End If
    
AbortOpen:
    ' Release the FileDialog object
    Set fd = Nothing
End Function
