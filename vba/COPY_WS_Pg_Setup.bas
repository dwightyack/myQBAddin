' Copy column widths of fromSheet to toSheet of Active workbook
Sub copyColumnWidths(ByVal fromSheet As String, ByVal toSheet As String)
Dim wsFrom As excel.Worksheet, wsTo As excel.Worksheet
Dim last_col As Long, i As Long, width As Double
    'On Error Resume Next
    Application.DisplayAlerts = False  'Disable alerts
    Application.ScreenUpdating = False 'Disable screen updating
    Set wsFrom = ActiveWorkbook.Sheets(fromSheet)
    Set wsTo = ActiveWorkbook.Sheets(toSheet)
    If wsFrom Is Nothing Or wsTo Is Nothing Then Exit Sub
    Call ShowAllGroupedColumns(wsFrom) ' Need to do this first to make it work
    last_col = Last(2, wsFrom.Cells)
    For i = 1 To last_col
        wsTo.Columns(i).ColumnWidth = wsFrom.Columns(i).ColumnWidth
        ' Debug.Print "Col " & i & "  width " & wsTo.Columns(i).ColumnWidth
    Next i
    Application.ScreenUpdating = True 'Re-enable screen updating
    Application.DisplayAlerts = True  'Re-enable alerts
    Set wsFrom = Nothing
    Set wsTo = Nothing
End Sub
Private Sub test_ShowAllGroupedColumns()
    ShowAllGroupedColumns ActiveSheet
End Sub
Sub ShowAllGroupedColumns(ws As Worksheet)
    ' Show all levels of column grouping Level 8 default...change as desired
    ws.Outline.ShowLevels ColumnLevels:=8
    ' Optional: Show all levels of row grouping as well
    ws.Outline.ShowLevels RowLevels:=8
End Sub
Private Sub test_ShowGroupRowLevel2ColumnLevel1()
    ShowGroupRowLevel2ColumnLevel1 ActiveSheet
End Sub
Sub ShowGroupRowLevel2ColumnLevel1(ws As Worksheet)
    ' Show level of column grouping
    ws.Outline.ShowLevels ColumnLevels:=1
    ' Show  levels of row grouping as well
    ws.Outline.ShowLevels RowLevels:=2
End Sub

Private Function SheetExists(ByVal strSheetName As String, Optional wbWorkbook As Workbook) As Boolean
    If wbWorkbook Is Nothing Then
        Set wbWorkbook = ActiveWorkbook           'or ThisWorkbook - whichever appropriate
    End If
    Dim obj As Object
    If hasQuotes(strSheetName) = True Then  'Sheet Names sometimes have single quotes
        strSheetName = stripQuotes(strSheetName) ' Strip single quotes from name
    End If
    Err.Clear
    On Error GoTo HandleError
    Set obj = wbWorkbook.Sheets(strSheetName)
    SheetExists = True
    Set obj = Nothing
    Exit Function
HandleError:
    Err.Clear
    SheetExists = False
    Set obj = Nothing
End Function
'
' This my Standard PRINT and SHEET SETUP Macro
'
Sub myFav_SheetSetup(Optional ws As Worksheet)
    If Not ws Is Nothing Then ws.Activate
    FreezeTopRow ActiveSheet.name
    ActiveWindowZoom150
    BoldCenterWrap_r Range("1:1")
    myFavPageFormat ActiveSheet
End Sub
' Sets the top row to always appear on top of screen and print pages
' Uses Active sheet and Active screen
Sub setTopRow_FreezeAndPrint()
    With ActiveWindow
        .SplitColumn = 0
        .SplitRow = 1
    End With
    ActiveWindow.FreezePanes = True
    With ActiveSheet.PageSetup
        .PrintTitleRows = "$1:$1"
        .PrintTitleColumns = ""
    End With
End Sub

Sub FreezeTopRow(sheetName As String)
    On Error Resume Next
    Sheets(sheetName).Activate
    Range("$A$2").Select
    Application.ActiveWindow.FreezePanes = True
End Sub
Sub ActiveWindowZoom150()
    ActiveWindow.Zoom = 150
End Sub
Sub BoldCenterWrap_r(r As Range)
' 1. FORMAT BOLD
' 2. ALINE CENTER HORIZONTAL
' 3. Wrap Text

    With r
        .Font.Bold = True                   ' Bold
        .HorizontalAlignment = xlCenter     ' Center
        .VerticalAlignment = xlBottom
        .WrapText = True                    ' Wrap Test
        .Orientation = 0
        .AddIndent = False
        .IndentLevel = 0
        .ShrinkToFit = False
        .ReadingOrder = xlContext
        .MergeCells = False
    End With
End Sub
' Swap the left print header with the right print header and vise versa
Sub swapLeftRightHeader(ws As Worksheet)
Dim s As String
    With ws.PageSetup
        ' PAGE HEADER
        s = .LeftHeader
        .LeftHeader = .RightHeader
        .RightHeader = s
    End With
End Sub
' 1. Repeat Row 1 ant Top of each Page
' 2. Page Header Setup
' 3. Page Footer Setup
' 4. Narrow Side MARGINS
' 5. Center Page Horizontally
' 6. Portrait Print
' 7. Fit to One Page wide
Sub myFavPageFormat(ws As Worksheet)
    Application.PrintCommunication = False
    With ws.PageSetup
        .PrintTitleRows = "$1:$1"  ' Repeat Row 1 AT TOP
        .PrintTitleColumns = ""    ' No Column Header
    End With
    Application.PrintCommunication = True
    ws.PageSetup.PrintArea = ""
    Application.PrintCommunication = False
    With ws.PageSetup
        ' PAGE HEADER
        .LeftHeader = "Pg &P of &N" ' Pg x of XX"
        .CenterHeader = "&A"        ' Sheet Name
        .RightHeader = "&D &T"      ' Date and Time
        ' PAGE FOOTER
        .LeftFooter = ""
        .CenterFooter = ""
        .RightFooter = "&8&Z&F"     ' 8 pt FONT , &Z File Path,  &F Name
        ' MARGINS
        .LeftMargin = Application.InchesToPoints(0.25)  ' NARROW LEFT MARGIN
        .RightMargin = Application.InchesToPoints(0.25) ' NARROW RIGHT MARGIN
        .TopMargin = Application.InchesToPoints(0.75)
        .BottomMargin = Application.InchesToPoints(0.75)
        .HeaderMargin = Application.InchesToPoints(0.3)
        .FooterMargin = Application.InchesToPoints(0.3)
        .PrintHeadings = False
        .PrintGridlines = False
        .PrintComments = xlPrintNoComments
        .CenterHorizontally = True              ' CENTER PAGE HORIZONTALLY
        .CenterVertically = False
        .Orientation = xlPortrait               ' PORTRAIT
        .Draft = False
        .PaperSize = xlPaperLetter
        .FirstPageNumber = xlAutomatic
        .Order = xlDownThenOver
        .BlackAndWhite = False
        .Zoom = False           ' Fit to One Page Wide
        .FitToPagesWide = 1     ' Fit to One Page Wide
        .FitToPagesTall = False ' Fit to One Page Wide
        
        .PrintErrors = xlPrintErrorsDisplayed
        .OddAndEvenPagesHeaderFooter = False
        .DifferentFirstPageHeaderFooter = False
        .ScaleWithDocHeaderFooter = True
        .AlignMarginsHeaderFooter = True
    End With
    Application.PrintCommunication = True
End Sub


