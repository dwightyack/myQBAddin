' Copy ALL print Settings from one Sheet to another of Active workbook
Sub copyPrintSettings(ByVal fromSheet As String, ByVal toSheet As String)
Dim wsFrom As excel.Worksheet, wsTo As excel.Worksheet
    'On Error Resume Next
    Set wsFrom = Sheets(fromSheet)
    Set wsTo = Sheets(toSheet)
    If wsFrom Is Nothing Or wsTo Is Nothing Then Exit Sub
    ' Copy Print Formatting... Nearly 50 properties
    Application.PrintCommunication = False
    With wsTo.PageSetup
        ' Copy Print Formatting. Copied Properties from Record Macro
        .LeftHeader = wsFrom.PageSetup.LeftHeader
        .CenterHeader = wsFrom.PageSetup.CenterHeader
        .RightHeader = wsFrom.PageSetup.RightHeader
        .LeftFooter = wsFrom.PageSetup.LeftFooter
        .CenterFooter = wsFrom.PageSetup.CenterFooter
        .RightFooter = wsFrom.PageSetup.RightFooter
        .LeftMargin = wsFrom.PageSetup.LeftMargin
        .RightMargin = wsFrom.PageSetup.RightMargin
        .TopMargin = wsFrom.PageSetup.TopMargin
        .BottomMargin = wsFrom.PageSetup.BottomMargin
        .HeaderMargin = wsFrom.PageSetup.HeaderMargin
        .FooterMargin = wsFrom.PageSetup.FooterMargin
        .PrintHeadings = wsFrom.PageSetup.PrintHeadings
        .PrintGridlines = wsFrom.PageSetup.PrintGridlines
        '.PrintComments = wsFrom.PageSetup.PrintComments
        '.PrintQuality = wsFrom.PageSetup.PrintQuality
        .CenterHorizontally = wsFrom.PageSetup.CenterHorizontally
        .CenterVertically = wsFrom.PageSetup.CenterVertically
        .Orientation = wsFrom.PageSetup.Orientation
        .Draft = wsFrom.PageSetup.Draft
        .PaperSize = wsFrom.PageSetup.PaperSize
        .FirstPageNumber = wsFrom.PageSetup.FirstPageNumber
        .Order = wsFrom.PageSetup.Order
        .BlackAndWhite = wsFrom.PageSetup.BlackAndWhite
        .Zoom = wsFrom.PageSetup.Zoom
        '.FitToPagesWide = wsFrom.PageSetup.FitToPagesWide
        .FitToPagesTall = wsFrom.PageSetup.FitToPagesTall
        .PrintErrors = wsFrom.PageSetup.PrintErrors
        .OddAndEvenPagesHeaderFooter = wsFrom.PageSetup.OddAndEvenPagesHeaderFooter
        .DifferentFirstPageHeaderFooter = wsFrom.PageSetup.DifferentFirstPageHeaderFooter
        .ScaleWithDocHeaderFooter = wsFrom.PageSetup.ScaleWithDocHeaderFooter
        .AlignMarginsHeaderFooter = wsFrom.PageSetup.AlignMarginsHeaderFooter
        .EvenPage.LeftHeader.Text = wsFrom.PageSetup.EvenPage.LeftHeader.Text
        .EvenPage.CenterHeader.Text = wsFrom.PageSetup.EvenPage.CenterHeader.Text
        .EvenPage.RightHeader.Text = wsFrom.PageSetup.EvenPage.RightHeader.Text
        .EvenPage.LeftFooter.Text = wsFrom.PageSetup.EvenPage.LeftFooter.Text
        .EvenPage.CenterFooter.Text = wsFrom.PageSetup.EvenPage.CenterFooter.Text
        .EvenPage.RightFooter.Text = wsFrom.PageSetup.EvenPage.RightFooter.Text
        .FirstPage.LeftHeader.Text = wsFrom.PageSetup.FirstPage.LeftHeader.Text
        .FirstPage.CenterHeader.Text = wsFrom.PageSetup.FirstPage.CenterHeader.Text
        .FirstPage.RightHeader.Text = wsFrom.PageSetup.FirstPage.RightHeader.Text
        .FirstPage.LeftFooter.Text = wsFrom.PageSetup.FirstPage.LeftFooter.Text
        .FirstPage.CenterFooter.Text = wsFrom.PageSetup.FirstPage.CenterFooter.Text
        .FirstPage.RightFooter.Text = wsFrom.PageSetup.FirstPage.RightFooter.Text
    End With
    Set wsFrom = Nothing
    Set wsTo = Nothing
    Application.PrintCommunication = True
End Sub
' Copy Title Row(s) and Title Column(s) properties from one Sheet to another of Active workbook
Sub copyPrintTitleRows(ByVal fromSheet As String, ByVal toSheet As String)
Dim wsFrom As excel.Worksheet, wsTo As excel.Worksheet
    'On Error Resume Next
    Set wsFrom = Sheets(fromSheet)
    Set wsTo = Sheets(toSheet)
    If wsFrom Is Nothing Or wsTo Is Nothing Then Exit Sub
    Application.PrintCommunication = False
    With wsTo.PageSetup
        ' Copy Title Rows and Title Columns properties
        .PrintTitleRows = wsFrom.PageSetup.PrintTitleRows
        .PrintTitleColumns = wsFrom.PageSetup.PrintTitleColumns
    End With
    Application.PrintCommunication = True
    Set wsFrom = Nothing
    Set wsTo = Nothing
End Sub
