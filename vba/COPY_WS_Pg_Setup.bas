' xlThemeColorLight2   Light Blue
' xlThemeColorAccent6  Light Green
Sub changeTabColor(ByVal sheetName As String, Optional ByVal theme As Variant = xlThemeColorLight1)
Dim ws As excel.Worksheet
    ' theme = xlThemeColorLight1 is a Black Tab (default)
    ' theme = 0 is NO COLOR  (standard Tab color)
    On Error Resume Next
    Set ws = Sheets(sheetName)
    If ws Is Nothing Then Exit Sub
    ' MsgBox " ColorIndex = " & ws.Tab.ColorIndex & " Theme Color = " & ws.Tab.ThemeColor
    If theme = 0 Then
        With ws.Tab
            .ColorIndex = xlColorIndexNone ' Standard Tab - remove color
        End With
    Else
        With ws.Tab
            .ThemeColor = theme '
        End With
    End If
End Sub
