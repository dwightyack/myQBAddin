'  whichOpen_WB_Dialog:
'       Find any open workbook '.xlsx' or searh for one in folderpath
'       Used to find new workbooks generated by BRC or QBDT
'       If user cancels out with no file name selected,
'           then bring up myOpenWorkbook file dialog
'   Args:
'       sheetName is used in dialog to user to select and activate a sheet
'       excludeWB can be a workbook whose name is excluded from user prompts in the dialog
'       folderP can be a folder path for user begin searching in when no open workbook was selected
'
'
Function whichOpen_WB_Dialog(sheetName As String, Optional excludeAddlWb As Workbook, _
                                Optional folderP As String = "") As Workbook
Dim FN As String, m As String, ans As Long
Dim ws As Worksheet, exclude_path As String '
Dim sheetMatches As Long, sheetCount As Long, lastMatch As Long
    If Not excludeAddlWb Is Nothing Then exclude_path = excludeAddlWb.path

    '************* Look at open WB files first *************
    If FN = "" Then
        FN = myQBAddin.whichOpen_WB("", excludeAddlWb, True) ' True = Exclude THISWORKBOOK
        Do
            If FN <> "" Then
                m = "Use open Workbook     '" & FN & "'" & vbCrLf
                If sheetName <> "" Then m = m & "for sheet      '" & sheetName & "'?"
                m = m & vbCrLf & vbCrLf & "No to Continue." & vbCrLf
                m = m & "Cancel to Abort."
                ans = MsgBox(m, vbYesNoCancel, "LOOKING FOR " & sheetName)
                If ans = vbCancel Then GoTo NoCanDo
                If ans = vbYes Then Exit Do
                ' if No then, go find the next one
                FN = myQBAddin.whichOpen_WB(FN, excludeAddlWb, True)
            End If
        Loop Until FN = "" ' looping on open WBs
    End If 'fn = ""
    
    If FN <> "" Then
        Set whichOpen_WB_Dialog = Workbooks(FN)
    Else
        ' fn = ""
    '************* Look for ANY unopened file Next Using:  myOpenWorkbook *************
    
        ' No Workbook open,  Variables NOT set
        ' Use default open WB function to look for a file.
        If folderP = "" And exclude_path <> "" Then folderP = exclude_path
        Set whichOpen_WB_Dialog = myQBAddin.myOpenWorkbook(, "*.*", , folderP)
        If whichOpen_WB_Dialog Is Nothing Then GoTo NoCanDo ' User canceled.
    End If
    
    ' Should we activate here?, but just to be safe
    'whichOpen_WB_Dialog.Activate
    
    '****************** Sheet selection Dialog ****************************************
    '
    ' If user passed in selection criteria in 'sheetName', count sheets matching the criteria.
    ' If sheetName is "" or "*", then there is no criteria, pass the workbook back.
    ' If only one sheet matches sheetName criteria, activate theat sheet and the workbook back.
    ' If only more than one sheet matches criteria, loop thru matching sheets and ask user.
    '
    '***********************************************************************************
    If sheetName = "" Or sheetName = "*" Then Exit Function ' Any Sheet, so exit here
    
    '************* Count matching sheets in opened Workbook *************
    sheetMatches = 0: sheetCount = 0: lastMatch = 0
    For Each ws In whichOpen_WB_Dialog.Worksheets
        sheetCount = sheetCount + 1
        If ws.name Like sheetName Then ' Use Like operator to find and count number of matches
            sheetMatches = sheetMatches + 1
            lastMatch = sheetCount
        End If
    Next ws
    
    ' If only one sheet matches sheetName criteria,
    ' activate theat sheet and the workbook back.
    If sheetMatches = 1 Then
        ' Activate the sheet and exit
        whichOpen_WB_Dialog.Worksheets(lastMatch).Activate
        Exit Function ' Only One Sheet matches criteria, so exit here
    End If
    
    
    '************* Prompt user to select sheetName in opened Workbook *************
    For Each ws In whichOpen_WB_Dialog.Worksheets
        If ws.name Like sheetName Then
            ' Activate the sheet so the user can see which one is being checked
            ws.Activate
            
            ' Show a Yes/No dialog box with the sheet name
            ans = MsgBox("Use this sheet: " & ws.name & "?", vbYesNo + vbQuestion, "whichOpen_WB_Dialog(): Sheet Selection")
            
            ' Check user response
            If ans = vbYes Then
                'Debug.Print "whichOpen_WB_Dialog(): Sheet " & ws.name & " was selected."
                Exit Function ' User selected a sheet, so exit here
            End If
        End If
    Next ws
    
    '**********  No Matches Like Sheetname. Prompt User to Select Any sheet ************
    m = "No sheets with a name like '" & sheetName & "' were found in " & whichOpen_WB_Dialog.name & "." & vbCrLf & vbCrLf
    m = m & "Do you want to see the list of sheets in " & whichOpen_WB_Dialog.name & "?"
    ans = MsgBox(m, vbQuestion + vbExclamation + vbYesNo, "whichOpen_WB_Dialog(): No matching Sheet names.")
    If ans = vbYes Then
        ' ADD USER SELECT SHEET CODE HERE
    
    End If
                       
    '*********** Error Out Here. User did not select a sheet. ****************
    m = "Workbook '" & whichOpen_WB_Dialog.name & " was selected but " & vbCrLf
    m = m & "user did not select a sheet or no sheets match the criteria: " & vbCrLf & vbCrLf
    m = m & "Sheets with a name like " & sheetName & " in workbook: '" & whichOpen_WB_Dialog.name & "'."
    MsgBox m, vbExclamation, "whichOpen_WB_Dialog(): Select Sheet failed."
    
NoCanDo:    ' User Canceled or invalid variables
    m = "User Canceled or whichOpen_WB_Dialog() failed." & vbCrLf & " File = '" & FN & "', sheetName = '" & sheetName & "'"
    Set whichOpen_WB_Dialog = Nothing
    Debug.Print m
    MsgBox m, , FN
End Function

Private Sub test_whichOpen_WB()
Dim last_nm As String
    last_nm = whichOpen_WB("")
    Debug.Print whichOpen_WB(last_nm)
End Sub
Function whichOpen_WB(last_nm As String, Optional excludeAddlWb As Workbook, _
                            Optional exclude_THIS_WB As Boolean = True) As String
Dim wb As Workbook, last_flag As Boolean
    last_flag = False

    ' ListAllWorkbooks ' For debugging purposes
    
    For Each wb In Workbooks
        'Debug.Print "whichOpen_WB " & wb.name
        
        ' **** Skip the previous one ****  returned from this function
        If last_nm <> "" And LCase(wb.name) = LCase(last_nm) Then
            last_flag = True
            GoTo next_wb
        End If
        
        ' **** Skip excludeAddlWB if set. ****
        If Not excludeAddlWb Is Nothing Then
            If LCase(excludeAddlWb.name) = LCase(wb.name) Then
                GoTo next_wb
            End If
        End If
        
        ' **** Skip THIS WORKBOOK if exclude_THIS_WB is True ****
        If exclude_THIS_WB Then
            If UCase(wb.name) = UCase(ThisWorkbook.name) Then GoTo next_wb
        End If
        
        ' **** skip entries until the last_nm (previous one) is hit ****
        If isWB_in_openWB(last_nm) Then
            If last_nm <> "" And Not last_flag Then
                GoTo next_wb
            Else ' past the last one
                whichOpen_WB = wb.name ' return this one
                Exit Function
            End If
        Else
            whichOpen_WB = wb.name ' return this one
            Exit Function
        End If
next_wb:
    Next wb ' Looping open workbooks
    Set wb = Nothing
End Function

Function isWB_in_openWB(last_nm As String) As Boolean
Dim wb As Workbook
isWB_in_openWB = False ' default
    
    ' ListAllWorkbooks ' For debugging purposes
    For Each wb In Workbooks
        If LCase(wb.name) = LCase(last_nm) Then
            isWB_in_openWB = True
            Exit Function
        End If
    Next wb ' Looping open workbooks
End Function


