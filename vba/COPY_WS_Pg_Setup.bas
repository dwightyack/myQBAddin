' https://stackoverflow.com/questions/12146271/getting-sheet-indice-from-sheet-name-in-vba
'   Dim adj_Ws  As Worksheet
'   Set adj_Ws = myAdjacentSheet(, , False) ' returns sheet BEFORE the active sheet
'   Set adj_Ws = myAdjacentSheet()          ' returns sheet AFTER the active sheet
'   Set adj_Ws = myAdjacentSheet(, "Test")  ' returns sheet AFTER sheet named "Test" in current workbook
'   Set adj_Ws = myAdjacentSheet(, "Test", , True) 'returns sheet AFTER sheet named "Test" in ANY OPEN WORKBOOK checking current workbook first
'
Function myAdjacentSheet(Optional ws As Worksheet, Optional wsName As String, Optional nextSheet As Boolean = True, Optional search As Boolean = False) As Worksheet
'   Expects worksheet or worksheet.name if blank, uses activesheet.
'   Third parameter indicates if the next sheet or previous sheet is wanted, default is next = true
'   Indicates adjacent sheet based on worksheet provided.
'   If worksheet is not provided, uses worksheet.name.
'   If no worksheet matches corresponding name, checks other workbooks if 4th parameter is true
'   If no worksheet can be found, alerts the user.
'   Returns found worksheet based upon criteria.
' DY - WARNING! - THIS FUNCTION RE-USES INPUT PARAMETERS
If (ws Is Nothing) Then
    If wsName = "" Then
        Set myAdjacentSheet = myAdjacentSheet(ActiveSheet, , nextSheet) ' Recursive, clever!
    Else ' wsName was something
        'Check all workbooks for the wsName, starting with activeWorkbook
        On Error Resume Next
        Set ws = Sheets(wsName)
        On Error GoTo 0
        If (ws Is Nothing) Then
            If search = True Then
                If Workbooks.count = 1 Then
                    GoTo notFound
                Else
                    Dim wb As Workbook  ' odd place for dim
                    For Each wb In Application.Workbooks ' loop search ALL open wb
                        On Error Resume Next
                        Set ws = wb.Sheets(wsName)
                        On Error GoTo 0
                        If Not (ws Is Nothing) Then
                            Set myAdjacentSheet = myAdjacentSheet(ws, , nextSheet) ' found one
                            Exit For
                        End If
                    Next '
                    If (ws Is Nothing) Then GoTo notFound
                End If
            Else
                GoTo notFound
            End If
        Else
            Set myAdjacentSheet = myAdjacentSheet(ws, , nextSheet, search)
        End If
    End If
Else ' ws is something
    With ws.Parent ' With workbook
        If nextSheet Then
            If ws.index = .Sheets.count Then
                Set myAdjacentSheet = .Sheets(1) ' return first sheet
            Else
                Set myAdjacentSheet = .Sheets(ws.index + 1) ' return next sheet
            End If
        Else ' get Before sheet
            If ws.index = 1 Then
                Set myAdjacentSheet = .Sheets(.Sheets.count) ' return last sheet
            Else
                Set myAdjacentSheet = .Sheets(ws.index - 1)  ' return sheet before
            End If
        End If
    End With ' with workbook
End If
Exit Function
notFound:
MsgBox "Worksheet named '" & wsName & "' could not be found!", vbCritical, "Invalid worksheet name."
End Function

' NOTES ON CopyWorksheetCloseWB:
' Used wtih ufrmSheetNames forms
' CopyWorksheetCloseWB(wB As Workbook, sheetName As String, beforeafterSheet As String,
'              Optional afterflag As Boolean = False, Optional replaceflag As Boolean = True)
' OPEN_WB as Copy To wb;  wB  = Open workbook to copy From and Close
' OPEN_WB is set by myOpenWorkbook. It is the Active wb before myOpenWorkbook was called
' sheetName     = Name of the sheet to copy
' beforeafterSheet = Place sheetName before or after this sheet in wB
' afterflag:    default False = Place before the beforeafterSheet in wB
' replaceflag:  default True = Replace if sheetname already exists in wB
' Return the FINAL name of the new sheet in wB

Function CopyWorksheetCloseWB(wb As Workbook, sheetName As String, beforeafterSheet As String, _
        Optional afterflag As Boolean = False, Optional replaceflag As Boolean = True) As String ' Called from User Forms
    ' Copies sheetname from wb to before or after beforeafterSheet of OPEN_WB workbook
Dim s As String, answer As Long, sheetno As Long
    On Error Resume Next
    ' If sheetname doesn't exist, then exit
    If Not SheetExists(sheetName, wb) Then Exit Function
    Application.DisplayAlerts = False ' Turn Off Prompts for Save, etc
    ' If sheetname already exists in open wb, and replace Flag set, then remove it first.
    If SheetExists(sheetName, OPEN_WB) And replaceflag Then
          OPEN_WB.Sheets(sheetName).Delete
    End If
    If SheetExists(beforeafterSheet, OPEN_WB) Then
        If afterflag Then
            wb.Sheets(sheetName).Copy After:=OPEN_WB.Sheets(beforeafterSheet)
            CopyWorksheetCloseWB = myAdjacentSheet(OPEN_WB.Sheets(beforeafterSheet), , True).name
        Else
            wb.Sheets(sheetName).Copy before:=OPEN_WB.Sheets(beforeafterSheet)
            CopyWorksheetCloseWB = myAdjacentSheet(OPEN_WB.Sheets(beforeafterSheet), , False).name
        End If
    Else
    ' If beforeafterSheet DOES NOT exist, then tell user and insert sheetName as first sheet in wB.
        s = "beforeafterSheet name '" & beforeafterSheet & "' does not exist." & vbCrLf
        s = s & "So, this sheet will be the First Sheet in the Workbook."
        answer = MsgBox(s, vbInformation)
        wb.Sheets(sheetName).Copy before:=OPEN_WB.Sheets(1) ' Before sheet
        CopyWorksheetCloseWB = myAdjacentSheet(OPEN_WB.Sheets(1), , False).name
        
    End If
    ' this wb is NOW no longer ActiveWorkbook
    wb.Close SaveChanges:=False '  Close opened WB
    Application.DisplayAlerts = True ' Turn back On Application Prompts
End Function

' NOTES ON CopyWorksheets:

' CopyWorksheets(from_wB As Workbook, to_wB as Workbook, sheetNames As String, beforeafterSheet As String,
'              Optional afterflag As Boolean = False, Optional replaceflag As Boolean = True)
' Copies SheetNames in from_WB to before or after beforeafterSheet of to_wB workbook
' Returns the FINAL names of the new sheets in to_WB as a COMMA SEPARATED STRING
'
'    from_wB        = WB to copy FROM
'    to_WB          = WB to copy TO
'    sheetNames     = Names of the sheets to copy as a COMMA SEPARATED STRING
'    beforeafterSheet = Place new sheet before or after this sheet name in to_WB
'    afterflag:      default False = Place before the beforeafterSheet in to_WB
'    replaceflag:    default True = Replace if sheetname already exists in to_WB

Function CopyWorksheets(from_WB As Workbook, to_WB As Workbook, ByVal sheetnames As String, ByVal beforeafterSheet As String, _
        Optional afterflag As Boolean = False, Optional replaceflag As Boolean = True) As String ' Called from User Forms
Dim m As String, answer As Long, sheetno As Long
Dim sheetName As String, last_DA_state As Boolean
Dim s_arr() As String, i As Long
    On Error Resume Next
    ' Turn Alerts off
    last_DA_state = Application.DisplayAlerts
    Application.DisplayAlerts = False ' Turn Off Prompts for Save, etc
    
    ' for each name in sheetNames, Copy name to to_WB
    If sheetnames = "" Then Exit Function
    s_arr = Split(sheetnames, ",")
    For i = LBound(s_arr()) To UBound(s_arr())
        sheetName = s_arr(i)
        ' If sheetname doesn't exist, Add Error Message and then go to next sheet
        If Not SheetExists(sheetName, from_WB) Then
            CopyWorksheets = CopyWorksheets & "File " & from_WB.name & ": Could not find sheet " & sheetName & ","
            GoTo next_sheet
        End If
        ' If sheetname already exists in open wb, and replace Flag set, then remove it first.
        If SheetExists(sheetName, to_WB) And replaceflag Then
              to_WB.Sheets(sheetName).Delete
        End If
        ' check if beforeafterSheet exists
        If SheetExists(beforeafterSheet, to_WB) Then
            If afterflag Then
                from_WB.Sheets(sheetName).Copy After:=to_WB.Sheets(beforeafterSheet)
                CopyWorksheets = CopyWorksheets & myAdjacentSheet(to_WB.Sheets(beforeafterSheet), , True).name & ","
            Else
                from_WB.Sheets(sheetName).Copy before:=to_WB.Sheets(beforeafterSheet)
                CopyWorksheets = CopyWorksheets & myAdjacentSheet(to_WB.Sheets(beforeafterSheet), , False).name & ","
            End If
        Else
        ' If beforeafterSheet DOES NOT exist, then tell user and insert sheetName as first sheet in wB.
            m = "beforeafterSheet name '" & beforeafterSheet & "' does not exist." & vbCrLf
            m = m & "So, this sheet will be the First Sheet in the Workbook."
            answer = MsgBox(m, vbInformation)
            from_WB.Sheets(sheetName).Copy before:=to_WB.Sheets(1) ' Before sheet
            CopyWorksheets = CopyWorksheets & myAdjacentSheet(to_WB.Sheets(1), , False).name & ","
        End If
next_sheet:
    Next i ' Next sheet name
    ' remove last comma
    If Right(CopyWorksheets, 1) = "," Then CopyWorksheets = Left(CopyWorksheets, Len(CopyWorksheets) - 1)
    ' Turn Alerts back on
    Application.DisplayAlerts = last_DA_state ' Turn Application Prompts back to last state
End Function

