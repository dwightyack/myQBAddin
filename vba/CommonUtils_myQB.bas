Attribute VB_Name = "CommonUtils_myQB"
Option Explicit


Private Sub test_whichOpen_CSV_Dialog()
Dim wb As Workbook
    Set wb = myQBAddin.whichOpen_CSV_Dialog(, "")
    If wb Is Nothing Then
        MsgBox "User selected nothing.": Exit Sub
    End If
    MsgBox "User Selected '" & wb.name & "' and sheet '" & ActiveSheet.name & "'."
   
End Sub

'  whichOpen_CSV_Dialog:
'       Find any open workbook '.CSV' or search for one in folderpath
'       Used to find CSV files generated by Interactive Broker
'       If user cancels out with no file name selected,
'           then bring up myOpenWorkbook file dialog
'   Args:
'       sheetName is used in dialog to user to select and activate a sheet
'       excludeWB can be a workbook whose name is excluded from user prompts in the dialog
'       folderP can be a folder path for user begin searching in when no open workbook was selected
'
'
Function whichOpen_CSV_Dialog(Optional excludeAddlWb As Workbook, _
                                Optional folderP As String = "") As Workbook
Dim FN As String, m As String, ans As Long
Dim ws As Worksheet, exclude_path As String '
    If Not excludeAddlWb Is Nothing Then exclude_path = excludeAddlWb.path

    '************* Look at open CSV files *************
    If FN = "" Then
        FN = myQBAddin.whichOpen_CSV("", excludeAddlWb, True) ' True = excluding this CSV workbook
        Do
            If FN <> "" Then
                m = "Use open Workbook     '" & FN & "'" & vbCrLf
                m = m & vbCrLf & vbCrLf & "No to Continue." & vbCrLf
                m = m & "Cancel to Abort."
                ans = MsgBox(m, vbYesNoCancel, "LOOKING FOR AN OPEN CSV FILE...")
                If ans = vbCancel Then GoTo NoCanDo
                If ans = vbYes Then Exit Do
                ' if No then, go find the next one
                FN = myQBAddin.whichOpen_CSV(FN, excludeAddlWb, True)
            End If
        Loop Until FN = "" ' looping on open WBs
    End If 'fn = ""
    
    If FN <> "" Then
        Set whichOpen_CSV_Dialog = Workbooks(FN)
    Else
        ' fn = ""
    '************* Look for ANY unopened CSV file Next Using:  myOpenWorkbook *************
    
        ' No Workbook open,  Variables NOT set
        ' Use default open WB function to look for a file.
        ' DON'T NEED THIS LINE FOR NS_Trade_Historical If folderP = "" And exclude_path <> "" Then folderP = exclude_path
        Set whichOpen_CSV_Dialog = myQBAddin.myOpenWorkbook(, "*.CSV", , folderP)
        If whichOpen_CSV_Dialog Is Nothing Then GoTo NoCanDo ' User canceled.
    End If
    
    Exit Function
                           
'    If UCase(Right(whichOpen_CSV_Dialog.name, 3)) = "CSV" Then
'        M = "You selected an file ending in " & M & vbCrLf & vbCrLf
'        M = M & "'" & whichOpen_CSV_Dialog.name & "'" & vbCrLf & vbCrLf
'        M = M & "Is this OK?" & vbCrLf & vbCrLf
'        ans = MsgBox(M, vbQuestion, "File Name does NOT end in .CSV...")
'
'    End If
'
    
NoCanDo:    ' User Canceled or invalid variables
    m = "User Canceled or whichOpen_CSV_Dialog() failed." & vbCrLf & " File = '" & FN & "'"
    Set whichOpen_CSV_Dialog = Nothing
    Debug.Print m
    MsgBox m, , FN
End Function

Private Sub test_whichOpen_CSV()
Dim last_nm As String
    last_nm = whichOpen_CSV("")
    Debug.Print whichOpen_CSV(last_nm)
End Sub
Function whichOpen_CSV(last_nm As String, Optional excludeAddlWb As Workbook, _
                            Optional exclude_THIS_CSV As Boolean = True) As String
Dim wb As Workbook, last_flag As Boolean
    last_flag = False

    ' ListAllWorkbooks ' For debugging purposes
    
    For Each wb In Workbooks
        'Debug.Print "whichOpen_CSV " & wb.name
        
        ' **** Skip the previous one ****  returned from this function
        If last_nm <> "" And LCase(wb.name) = LCase(last_nm) Then
            last_flag = True
            GoTo next_wb
        End If
        
        ' **** Skip excludeAddlWB if set. ****
        If Not excludeAddlWb Is Nothing Then
            If LCase(excludeAddlWb.name) = LCase(wb.name) Then
                GoTo next_wb
            End If
        End If
        
        ' **** Skip THIS WORKBOOK if exclude_THIS_CSV is True ****
        If exclude_THIS_CSV Then
            If UCase(wb.name) = UCase(ThisWorkbook.name) Then GoTo next_wb
        End If
        
         ' **** Skip names that do NOT end with .CSV **********
        If UCase(Right(wb.name, 4)) <> ".CSV" Then
            GoTo next_wb  ' Not a csv file
        End If

       
        ' **** skip entries until the last_nm (previous one) is hit ****
        If isWB_in_openWB(last_nm) Then
            If last_nm <> "" And Not last_flag Then
                GoTo next_wb
            Else ' past the last one
                whichOpen_CSV = wb.name ' return this one
                Exit Function
            End If
        Else
            whichOpen_CSV = wb.name ' return this one
            Exit Function
        End If
next_wb:
    Next wb ' Looping open workbooks
    Set wb = Nothing
End Function


